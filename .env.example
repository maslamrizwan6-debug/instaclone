# Copy this file to ".env" for running on your own computer.
# On Render, add these as "Environment Variables" instead (never upload your real keys to GitHub).

# Supabase → Connect → "Session pooler" connection string (replace [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...) or legacy service_role key
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxx
